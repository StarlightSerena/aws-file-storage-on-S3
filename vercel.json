{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/upload",
      "destination": "/api/index.js"
    },
    {
      "source": "/files",
      "destination": "/api/index.js"
    },
    {
      "source": "/download/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/delete/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
